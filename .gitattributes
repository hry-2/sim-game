# 统一换行，避免跨平台 diff 噪音
* text=auto eol=lf
*.bat text eol=crlf

# 二进制资产不做文本 diff
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.aseprite binary
*.ttf binary
*.otf binary

# 让 GitHub 语言统计忽略第三方与资产目录
assets/**      linguist-vendored
vendor/**      linguist-vendored
docs/**        linguist-documentation

# 如启用 Git LFS，取消下面注释
# *.psd  filter=lfs diff=lfs merge=lfs -text
# *.wav  filter=lfs diff=lfs merge=lfs -text
